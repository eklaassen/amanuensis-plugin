{{page-title (if this.model.meeting.title this.model.meeting.title "Meeting")}}

<div class="amanuensis-container">
  <LinkTo @route="amanuensis-meetings" class="amanuensis-back-link">&larr; Back to meetings</LinkTo>

  {{#if this.model.error}}
    <AmanuensisError @message={{this.model.error}} />
  {{else if this.model.meeting}}
    <header class="amanuensis-header">
      <h1>{{this.model.meeting.title}}</h1>
      <div class="amanuensis-header-badges">
        <AmanuensisMeetingBadges @meeting={{this.model.meeting}} />
      </div>
    </header>

    <section class="amanuensis-section amanuensis-metadata">
      <div class="amanuensis-metadata-grid">
        <AmanuensisMetadataItem @label="Recorded" @value={{this.model.meeting.recorded_at}} />
        {{#if this.model.meeting.duration}}
          <AmanuensisMetadataItem @label="Duration" @value={{this.model.meeting.duration}} />
        {{/if}}
        <AmanuensisMetadataItem @label="Source" @value={{this.model.meeting.source_label}} />
        {{#if this.model.meeting.discourse_topic_id}}
          <div class="amanuensis-metadata-item">
            <span class="amanuensis-label">Discourse Topic</span>
            <span class="amanuensis-value">
              <a href="/t/{{this.model.meeting.discourse_topic_id}}">Topic #{{this.model.meeting.discourse_topic_id}}</a>
            </span>
          </div>
        {{/if}}
      </div>
    </section>

    {{#if this.model.meeting.summary_html}}
      <section class="amanuensis-section amanuensis-summary">
        <h2>Meeting Summary</h2>
        {{! summary_html is a SafeString (trustHTML, applied in the route) --
            already sanitized server-side, so a plain mustache here renders
            the markup instead of escaping it. }}
        <div class="amanuensis-summary-content">{{this.model.meeting.summary_html}}</div>
      </section>
    {{/if}}

    {{#if this.model.notesbot_groups}}
      <section class="amanuensis-section amanuensis-notesbot">
        <details class="amanuensis-foldable">
          <summary class="amanuensis-foldable-header">
            <span class="amanuensis-foldable-icon">📜</span>
            <span class="amanuensis-foldable-title">Vintage NotesBot Transcript</span>
            <span class="amanuensis-foldable-count">{{this.model.notesbot_turn_count}} turns</span>
            <span class="amanuensis-foldable-toggle">expand</span>
          </summary>
          <div class="amanuensis-notesbot-transcript">
            {{#each this.model.notesbot_groups as |group|}}
              <div class="amanuensis-speaker-group">
                <div class="amanuensis-speaker-header" style="--amanuensis-speaker-color: {{group.speaker_color}}">
                  {{group.speaker}}
                  <span class="amanuensis-speaker-count">{{group.turn_count}} lines</span>
                </div>
                {{#each group.turns as |turn|}}
                  <div class="amanuensis-turn">
                    <span class="amanuensis-turn-time">{{turn.timestamp}}</span>
                    <span class="amanuensis-turn-speaker" style="--amanuensis-speaker-color: {{group.speaker_color}}">{{group.speaker}}</span>
                    <span class="amanuensis-turn-text">{{turn.text}}</span>
                  </div>
                {{/each}}
              </div>
            {{/each}}
          </div>
        </details>
      </section>
    {{/if}}

    {{#if this.model.proposal}}
      <section class="amanuensis-section amanuensis-proposal">
        <h2>Proposal Items</h2>
        <p class="amanuensis-proposal-state">State: <strong>{{this.model.proposal.state}}</strong></p>

        {{#each this.model.proposal.groups as |group|}}
          <div class="amanuensis-item-group">
            <h3 class="amanuensis-item-group-header amanuensis-item-group-{{group.decision}}">
              {{group.decision_label}}
              <span class="amanuensis-item-count">{{group.count}}</span>
            </h3>
            <div class="amanuensis-item-cards">
              {{#each group.items as |item|}}
                <AmanuensisProposalItemCard @item={{item}} />
              {{/each}}
            </div>
          </div>
        {{/each}}
      </section>
    {{/if}}

    {{#if this.model.history.length}}
      <section class="amanuensis-section amanuensis-history">
        <h2>Applied Changes</h2>
        <div class="amanuensis-history-cards">
          {{#each this.model.history as |entry|}}
            <AmanuensisHistoryCard @entry={{entry}} />
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if this.model.stage_runs.length}}
      <section class="amanuensis-section amanuensis-pipeline-timeline">
        <h2>Pipeline Timeline</h2>
        <AmanuensisStageTimeline @runs={{this.model.stage_runs}} />
      </section>
    {{/if}}
  {{/if}}
</div>
