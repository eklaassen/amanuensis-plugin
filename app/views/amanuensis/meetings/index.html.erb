<% content_for :title, "Writers' Room Meetings" %>

<header class="amanuensis-header">
  <h1>
    <%= render 'amanuensis/shared/icon', name: 'clipboard', size: 24, css_class: 'amanuensis-icon' %>
    Writers' Room Meetings
  </h1>
</header>

<% if @error %>
  <%= render 'amanuensis/shared/error', message: @error %>
<% elsif @meetings.present? %>
  <div class="amanuensis-meetings-list">
    <% @meetings.each do |m| %>
      <a href="/amanuensis/meetings/<%= m['id'] %>" class="amanuensis-meeting-card">
        <div class="amanuensis-card-header">
          <h3 class="amanuensis-meeting-title"><%= m['title'] %></h3>
          <%= render 'amanuensis/shared/meeting_badges', meeting: m %>
        </div>
        <div class="amanuensis-card-meta">
          <span class="amanuensis-meta-item">
            <%= render 'amanuensis/shared/icon', name: 'clock', size: 14 %>
            <%= formatted_date(m['recorded_at']) %>
          </span>
          <span class="amanuensis-meta-item">
            <%= render 'amanuensis/shared/icon', name: 'mic', size: 14 %>
            <%= m['source'].humanize %>
          </span>
          <% if m['duration_seconds'] %>
            <span class="amanuensis-meta-item">
              <%= render 'amanuensis/shared/icon', name: 'clock', size: 14 %>
              <%= format_duration(m['duration_seconds']) %>
            </span>
          <% end %>
          <% if m['has_notesbot_transcript'] %>
            <span class="amanuensis-meta-item amanuensis-meta-notesbot">
              &#x1F4DC; Vintage notes available
            </span>
          <% end %>
          <% if m['has_summary'] %>
            <span class="amanuensis-meta-item">
              &#x1F4CB; Summary
            </span>
          <% end %>
        </div>
      </a>
    <% end %>
  </div>

  <%= render 'amanuensis/shared/pagination',
        base_path: '/amanuensis/meetings',
        has_more: @pagination['has_more'],
        next_before: @pagination['next_before'],
        extra_params: params[:status].present? ? { status: params[:status] } : {} %>
<% else %>
  <%= render 'amanuensis/shared/empty', message: 'No meetings found.' %>
<% end %>
