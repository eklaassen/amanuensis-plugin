<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? yield(:title) : 'Amanuensis' %></title>
  <%= csrf_meta_tags %>
  <%= discourse_stylesheet_link_tag 'amanuensis' %>
</head>
<body class="amanuensis-page">
  <div class="amanuensis-container">
    <nav class="amanuensis-nav">
      <a href="/amanuensis/meetings" class="amanuensis-nav-link<%= ' amanuensis-nav-link-active' if request.path == '/amanuensis' || request.path.start_with?('/amanuensis/meetings') %>">Meetings</a>
      <a href="/amanuensis/pipeline" class="amanuensis-nav-link<%= ' amanuensis-nav-link-active' if request.path.start_with?('/amanuensis/pipeline') %>">Active</a>
      <a href="/amanuensis/outcomes" class="amanuensis-nav-link<%= ' amanuensis-nav-link-active' if request.path.start_with?('/amanuensis/outcomes') %>">Outcomes</a>
      <% if Amanuensis::Permissions.writer?(current_user) %>
        <a href="/amanuensis/uploads/new" class="amanuensis-nav-link<%= ' amanuensis-nav-link-active' if request.path.start_with?('/amanuensis/uploads') %>">Upload</a>
      <% end %>
    </nav>
    <%= yield %>
  </div>
</body>
</html>
